{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "globalDependencies": ["**/.env.*.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "cache": true,
      "env": [
        "NODE_ENV",
        "SKIP_ENV_VALIDATION"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "content:build": {
      "outputs": ["app/api-v2/md/**", "public/**"],
      "cache": true
    }
  }
}
