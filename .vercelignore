# Exclude all workspace packages except clubedge
/apps/*/
!/apps/clubedge/

# Exclude other workspace packages
/packages/

# Documentation and dev files
/*.md
/.github/
/.vscode/
/.cursor/
/.husky/
/docs/

# Test files
*.test.ts
*.test.tsx
*.test.js
*.spec.ts
*.spec.tsx

# Build outputs and cache
/dist/
/.next/
/build/
/.turbo/
/coverage/

# Node modules
/node_modules/
/.pnpm-store/

# Environment files
.env
.env.local
.env.*.local
.env.production.local

# Git
/.git/
/.gitignore
